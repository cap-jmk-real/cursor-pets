{
  "name": "@cursor-pets/companion",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/main.cjs",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "node ./scripts/build.mjs --watch & electron .",
    "start": "set CURSOR_PETS_USERDATA=%USERPROFILE%\\.cursor-pets\\companion\\userdata&& set CURSOR_PETS_CACHE=%USERPROFILE%\\.cursor-pets\\companion\\cache&& electron . --user-data-dir=\"%CURSOR_PETS_USERDATA%\" --disk-cache-dir=\"%CURSOR_PETS_CACHE%\"",
    "lint": "node -e \"process.exit(0)\"",
    "typecheck": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@cursor-pets/core": "0.1.0",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "electron": "^35.4.0"
  }
}

