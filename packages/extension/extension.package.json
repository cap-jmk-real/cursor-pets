{
  "name": "cursor-pets",
  "displayName": "Cursor Pets",
  "description": "A tiny pet companion for Cursor.",
  "version": "0.1.0",
  "publisher": "cursor-pets",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:cursorPets.view"],
  "main": "./dist/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorPets.container",
          "title": "Pets",
          "icon": "media/paw.svg"
        }
      ]
    },
    "views": {
      "cursorPets.container": [
        {
          "id": "cursorPets.view",
          "name": "Cursor Pets"
        }
      ]
    },
    "commands": [
      { "command": "cursorPets.selectPet", "title": "Cursor Pets: Select Pet" },
      { "command": "cursorPets.toggle", "title": "Cursor Pets: Toggle View" },
      { "command": "cursorPets.resetState", "title": "Cursor Pets: Reset State" },
      { "command": "cursorPets.actions", "title": "Cursor Pets: Actions" },
      { "command": "cursorPets.hide", "title": "Cursor Pets: Hide" },
      { "command": "cursorPets.generatePet", "title": "Cursor Pets: Generate Pet…" }
    ]
  }
}

