{
  "name": "cursor-pets",
  "displayName": "Cursor Pets",
  "description": "A tiny pet companion for Cursor.",
  "version": "0.1.0",
  "publisher": "cursor-pets",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cursorPets.openFloatingCompanion",
    "onCommand:cursorPets.quickMenu",
    "onCommand:cursorPets.selectPet"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "cursorPets.quickMenu",
        "title": "Cursor Pets: Menu"
      },
      { "command": "cursorPets.selectPet", "title": "Cursor Pets: Select Pet" },
      { "command": "cursorPets.toggle", "title": "Cursor Pets: Menu (legacy)" },
      { "command": "cursorPets.resetState", "title": "Cursor Pets: Reset State" },
      { "command": "cursorPets.actions", "title": "Cursor Pets: Actions" },
      { "command": "cursorPets.hide", "title": "Cursor Pets: About sidebar mode" },
      { "command": "cursorPets.generatePet", "title": "Cursor Pets: Generate Pet…" },
      {
        "command": "cursorPets.openFloatingCompanion",
        "title": "Cursor Pets: Open Floating Pet (sprites, no title bar)"
      }
    ]
  }
}
